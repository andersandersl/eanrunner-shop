# Local dev only. Cloud Run injects PORT automatically.
PORT=8787
WEB_ORIGIN=https://shop.eanrunner.com

# Azure SQL
SQL_SERVER=eanrunner-sql.database.windows.net
SQL_DATABASE=eanrunner-db
SQL_USER=
SQL_PASSWORD=

# Email (Resend) — leave blank to disable email sending
RESEND_API_KEY=
REQUEST_FROM_EMAIL=EANrunner <notifications@eanrunner.com>
REQUEST_INTERNAL_EMAIL=
